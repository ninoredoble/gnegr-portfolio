---
import '../styles/global.css';
import Dock from '../components/react/Dock';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Niño Redoble · Product designer & engineer',
  description = 'I design and build web and mobile apps for businesses, from the first sketch to the version your customers use. Co-founder of MixCortex; Kivora is live on the App Store.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#fdf6eb" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Niño Redoble, designer and developer, over a paper-cut landscape of a river valley with mountains and a vinta." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href="/fonts/empanada/empanada-bold.otf" as="font" type="font/otf" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <Dock client:idle />
    <script>
      // Fade-and-rise for anything marked .reveal; rows in a list stagger via --d.
      const targets = document.querySelectorAll<HTMLElement>('.reveal');
      if (!('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
