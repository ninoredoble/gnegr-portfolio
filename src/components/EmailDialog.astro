---
// "Email me", built into the site. Visitors write the message here, then choose where to send
// it from: Gmail, Outlook or Yahoo open a ready-to-send draft in a new tab; "Mail app" uses
// mailto:. They can also just copy the address. Nothing is sent or stored by this site.
// Opened by any element with [data-email-open]; a native <dialog>, so Esc and focus work.
import Icon from './Icon.astro';
import { EMAIL } from '../data/contact';

const services = [
  { id: 'gmail', label: 'Gmail', icon: 'gmail' },
  { id: 'outlook', label: 'Outlook', icon: 'outlook' },
  { id: 'yahoo', label: 'Yahoo Mail', icon: 'yahoo' },
  { id: 'app', label: 'Mail app', icon: 'mail' },
] as const;
---

<dialog id="email-dialog" class="email" aria-labelledby="email-title" data-email={EMAIL}>
  <form method="dialog" class="sheet" novalidate>
    <div class="top">
      <h2 id="email-title" class="display">SAY HELLO.</h2>
      <button class="x" type="submit" value="close" aria-label="Close">
        <Icon name="close" />
      </button>
    </div>
    <p class="lede">Tell me what you're working on. Pick where to send it from and it opens ready to go.</p>

    <label class="field">
      <span>Your name</span>
      <input name="name" type="text" autocomplete="name" />
    </label>
    <label class="field">
      <span>Subject</span>
      <input name="subject" type="text" value="Project inquiry" />
    </label>
    <label class="field">
      <span>Message</span>
      <textarea name="message" rows="5" required aria-describedby="email-error"></textarea>
    </label>
    <p id="email-error" class="error" role="alert" hidden>Write a short message first.</p>

    <p class="send-label">Send it with</p>
    <div class="services">
      {
        services.map((s) => (
          <button type="button" class="service" data-service={s.id}>
            <Icon name={s.icon} />
            <span>{s.label}</span>
          </button>
        ))
      }
    </div>

    <div class="copy-row">
      <span class="addr">{EMAIL}</span>
      <button type="button" class="copy" data-copy>
        <Icon name="copy" size={18} />
        <span data-copy-label>Copy address</span>
      </button>
    </div>
    <p class="sr-only" aria-live="polite" data-live></p>
  </form>
</dialog>

<script>
  const dialog = document.getElementById('email-dialog') as HTMLDialogElement | null;
  if (dialog) {
    const form = dialog.querySelector('form')!;
    const email = dialog.dataset.email!;
    const error = dialog.querySelector<HTMLElement>('#email-error')!;
    const live = dialog.querySelector<HTMLElement>('[data-live]')!;
    const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLTextAreaElement;

    document.addEventListener('click', (e) => {
      const opener = (e.target as HTMLElement).closest('[data-email-open]');
      if (!opener) return;
      e.preventDefault();
      error.hidden = true;
      dialog.showModal();
      field('message').focus();
    });
    // Enter in a text field must not submit (and so close) the dialog; only the × closes it.
    form.addEventListener('submit', (e) => {
      if ((e.submitter as HTMLButtonElement | null)?.value !== 'close') e.preventDefault();
    });
    // Click on the backdrop closes it.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    const compose = () => {
      const message = field('message').value.trim();
      if (!message) {
        error.hidden = false;
        field('message').focus();
        return null;
      }
      error.hidden = true;
      const name = field('name').value.trim();
      const subject = field('subject').value.trim() || 'Project inquiry';
      const body = name ? `${message}\n\n— ${name}` : message;
      return { subject, body };
    };

    const enc = encodeURIComponent;
    const links: Record<string, (s: string, b: string) => string> = {
      gmail: (s, b) => `https://mail.google.com/mail/?view=cm&fs=1&to=${enc(email)}&su=${enc(s)}&body=${enc(b)}`,
      outlook: (s, b) => `https://outlook.live.com/mail/0/deeplink/compose?to=${enc(email)}&subject=${enc(s)}&body=${enc(b)}`,
      yahoo: (s, b) => `https://compose.mail.yahoo.com/?to=${enc(email)}&subject=${enc(s)}&body=${enc(b)}`,
      app: (s, b) => `mailto:${email}?subject=${enc(s)}&body=${enc(b)}`,
    };

    dialog.querySelectorAll<HTMLButtonElement>('[data-service]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const draft = compose();
        if (!draft) return;
        const url = links[btn.dataset.service!](draft.subject, draft.body);
        if (btn.dataset.service === 'app') location.href = url;
        else window.open(url, '_blank', 'noopener');
      });
    });

    const copyBtn = dialog.querySelector<HTMLButtonElement>('[data-copy]')!;
    const copyLabel = copyBtn.querySelector<HTMLElement>('[data-copy-label]')!;
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(email);
        copyLabel.textContent = 'Copied';
        live.textContent = 'Email address copied';
      } catch {
        copyLabel.textContent = 'Select and copy';
      }
      setTimeout(() => (copyLabel.textContent = 'Copy address'), 2200);
    });
  }
</script>

<style>
  .email {
    width: min(560px, calc(100vw - 24px));
    max-height: calc(100dvh - 24px);
    padding: 0;
    border: 0;
    background: var(--paper);
    color: var(--rosewood);
    box-shadow: 0 24px 60px rgb(77 41 38 / 0.35);
    overflow: auto;
  }
  .email::backdrop {
    background: rgb(77 41 38 / 0.55);
  }
  .email[open] {
    animation: pop 0.35s var(--ease-out);
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(16px) rotate(-1deg);
    }
  }
  .sheet {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(20px, 4vw, 32px);
    border-top: 10px solid var(--rosewood);
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 12px;
  }
  h2 {
    font-size: clamp(40px, 7vw, 60px);
    line-height: 0.9;
  }
  .x {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 2px solid var(--rosewood);
    background: transparent;
    color: var(--rosewood);
    cursor: pointer;
  }
  .x:hover {
    background: var(--rosewood);
    color: var(--paper);
  }
  .lede {
    font-size: 17px;
    line-height: 1.5;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14px;
    font-weight: 700;
  }
  input,
  textarea {
    font: inherit;
    font-size: 17px;
    font-weight: 400;
    color: var(--rosewood);
    background: #fff;
    border: 2px solid var(--rosewood);
    padding: 10px 12px;
    min-height: 44px;
    resize: vertical;
  }
  input:focus-visible,
  textarea:focus-visible,
  button:focus-visible {
    outline: 3px solid var(--sakura);
    outline-offset: 2px;
  }
  .error {
    margin-top: -6px;
    font-size: 14px;
    font-weight: 700;
  }
  .send-label {
    margin-top: 4px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .services {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .service {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 14px;
    font: inherit;
    font-weight: 700;
    font-size: 16px;
    color: var(--rosewood);
    background: var(--paper);
    border: 2px solid var(--rosewood);
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s,
      transform 0.2s;
  }
  .service:hover {
    background: var(--rosewood);
    color: var(--paper);
    transform: translateY(-2px);
  }
  .copy-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding-top: 12px;
    border-top: 1px solid var(--rosewood);
  }
  .addr {
    font-size: 15px;
    overflow-wrap: anywhere;
  }
  .copy {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 14px;
    font: inherit;
    font-weight: 700;
    font-size: 15px;
    color: var(--paper);
    background: var(--rosewood);
    border: 0;
    cursor: pointer;
  }
  .copy:hover {
    background: var(--sakura);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  @media (max-width: 480px) {
    .services {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .email[open] {
      animation: none;
    }
  }
</style>
