---
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';

interface Props {
  items: CollectionEntry<'work'>[];
  total: number;
}
const { items, total } = Astro.props;
const label: Record<CollectionEntry<'work'>['data']['kind'], string> = {
  product: 'PRODUCT',
  process: 'PROCESS',
  production: 'PRODUCTION',
  systems: 'SYSTEMS',
  study: 'STUDY',
};
---

<section class="wrap" id="work" aria-labelledby="work-h">
  <div class="head reveal">
    <h2 id="work-h" class="display">SELECTED WORK</h2>
    <a class="more" href="/lab/">{items.length} OF {total} · MORE IN THE LAB →</a>
  </div>
  <ol>
    {
      items.map((w, i) => (
        <li class="reveal" style={`--d:${(i * 0.07).toFixed(2)}s; --tilt:${i % 2 ? 2 : -2}deg`}>
          <a class="row" href={`/work/${w.id}/`}>
            <span class="n display">{String(i + 1).padStart(2, '0')}</span>
            <span class="text">
              <span class="tag">{label[w.data.kind]}</span>
              <span class="t display">{w.data.title.toUpperCase()}</span>
              <span class="d">{w.data.summary}</span>
            </span>
            {w.data.thumb && (
              <span class="card" aria-hidden="true">
                <Picture src={w.data.thumb} alt="" widths={[320, 560]} sizes="(max-width: 820px) 80vw, 280px" formats={['avif', 'webp']} fallbackFormat="jpg" width={560} />
              </span>
            )}
          </a>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    border-bottom: 3px solid var(--rosewood);
    padding-bottom: 12px;
  }
  h2 {
    font-size: clamp(44px, 6vw, 84px);
    line-height: 1;
  }
  .more {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--rosewood);
    text-decoration: none;
    padding: 12px 0;
  }
  .more:hover {
    color: var(--sakura);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: clamp(56px, 8vw, 110px) minmax(0, 1fr) clamp(200px, 22vw, 300px);
    gap: clamp(14px, 2.4vw, 36px);
    align-items: center;
    padding: clamp(20px, 2.6vw, 34px) 0;
    border-bottom: 1px solid var(--rosewood);
    color: var(--rosewood);
    text-decoration: none;
  }
  .n {
    align-self: start;
    font-size: clamp(44px, 5.4vw, 76px);
    line-height: 0.9;
    color: var(--sakura);
    transition: transform 0.35s var(--ease-out);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .tag {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .t {
    font-size: clamp(34px, 4vw, 58px);
    line-height: 0.95;
    transition: color 0.2s;
  }
  .d {
    font-size: 18px;
    line-height: 1.45;
    max-width: 34em;
  }

  /* The thumbnail is a paper card: tilted, it straightens and lifts when the row is hovered. */
  .card {
    display: block;
    border: 6px solid var(--paper);
    outline: 2px solid var(--rosewood);
    background: var(--paper);
    transform: rotate(var(--tilt));
    filter: drop-shadow(0 10px 14px rgb(77 41 38 / 0.25));
    transition:
      transform 0.45s var(--ease-out),
      filter 0.3s;
  }
  .card :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
  }
  .row:hover .card,
  .row:focus-visible .card {
    transform: rotate(0deg) translateY(-6px) scale(1.03);
    filter: drop-shadow(0 18px 20px rgb(77 41 38 / 0.32));
  }
  .row:hover .t,
  .row:focus-visible .t {
    color: var(--sakura);
  }
  .row:hover .n,
  .row:focus-visible .n {
    transform: translateX(8px);
  }

  @media (max-width: 820px) {
    .row {
      grid-template-columns: 52px minmax(0, 1fr);
      align-items: start;
    }
    .card {
      grid-column: 2;
      max-width: 420px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card,
    .n {
      transition: none;
    }
  }
</style>
