---
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';

interface Props {
  items: CollectionEntry<'work'>[];
  total: number;
}
const { items, total } = Astro.props;
const label: Record<CollectionEntry<'work'>['data']['kind'], string> = {
  product: 'Product',
  process: 'Process',
  production: 'Production',
  systems: 'Systems',
  study: 'Study',
};
---

<section class="wrap" id="work" aria-labelledby="work-h">
  <div class="head reveal">
    <h2 id="work-h" class="display">SELECTED WORK</h2>
    <a class="more" href="/lab/">{items.length} of {total} · more in the Lab →</a>
  </div>
  <ol>
    {
      items.map((w, i) => (
        <li class="reveal" style={`--d:${(i * 0.07).toFixed(2)}s; --tilt:${i % 2 ? 2 : -2}deg; --kc: var(--kind-${w.data.kind})`}>
          <a class="row" href={`/work/${w.id}/`}>
            <span class="n display">{String(i + 1).padStart(2, '0')}</span>
            <span class="text">
              <span class="t display">{w.data.title.toUpperCase()}</span>
              <span class="d">{w.data.summary}</span>
              <span class="tag">{label[w.data.kind]}</span>
            </span>
            {w.data.thumb && (
              <span class="card" aria-hidden="true">
                <Picture src={w.data.thumb} alt="" widths={[320, 560]} sizes="(max-width: 820px) 80vw, 280px" formats={['avif', 'webp']} fallbackFormat="jpg" width={560} />
              </span>
            )}
          </a>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    border-bottom: 3px solid var(--rosewood);
    padding-bottom: 12px;
  }
  h2 {
    font-size: clamp(44px, 6vw, 84px);
    line-height: 1;
  }
  .more {
    font-size: 15px;
    font-weight: 700;
    color: var(--river-ink);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--river-ink) 35%, transparent);
    text-underline-offset: 4px;
    padding: 12px 0;
    transition: text-decoration-color 0.2s;
  }
  .more:hover {
    text-decoration-color: var(--river-ink);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    /* below the fold: skip rendering until it's near the screen */
    content-visibility: auto;
    contain-intrinsic-size: auto 1200px;
  }
  li {
    border-bottom: 1px solid var(--line);
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: clamp(56px, 8vw, 110px) minmax(0, 1fr) clamp(200px, 22vw, 300px);
    gap: clamp(14px, 2.4vw, 36px);
    align-items: center;
    padding: clamp(22px, 2.8vw, 36px) clamp(0px, 1vw, 12px);
    color: var(--ink);
    text-decoration: none;
    transition: background-color 0.3s;
  }
  /* A wash of the row's own colour on hover. */
  .row:hover,
  .row:focus-visible {
    background: color-mix(in oklab, var(--kc) 9%, var(--paper));
  }
  .n {
    align-self: start;
    font-size: clamp(44px, 5.4vw, 76px);
    line-height: 0.9;
    color: var(--kc);
    transition: transform 0.35s var(--ease-out);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }
  .t {
    font-size: clamp(34px, 4vw, 58px);
    line-height: 0.95;
    color: var(--rosewood);
    transition: color 0.2s;
  }
  .d {
    font-size: 18px;
    line-height: 1.5;
    max-width: 34em;
  }
  .tag {
    align-self: start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px 3px 8px;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    background: color-mix(in oklab, var(--kc) 16%, var(--paper));
  }
  .tag::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--kc);
  }

  /* The thumbnail is a paper card: tilted, it straightens and lifts when the row is hovered. */
  .card {
    display: block;
    border: 6px solid var(--paper);
    outline: 2px solid color-mix(in oklab, var(--kc) 60%, var(--ink));
    background: var(--paper);
    transform: rotate(var(--tilt));
    filter: drop-shadow(0 10px 14px rgb(62 44 32 / 0.22));
    transition:
      transform 0.45s var(--ease-out),
      filter 0.3s;
  }
  .card :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
  }
  .row:hover .card,
  .row:focus-visible .card {
    transform: rotate(0deg) translateY(-6px) scale(1.03);
    filter: drop-shadow(0 18px 20px rgb(62 44 32 / 0.3));
  }
  .row:hover .t,
  .row:focus-visible .t {
    color: var(--river-ink);
  }
  .row:hover .n,
  .row:focus-visible .n {
    transform: translateX(8px);
  }

  @media (max-width: 820px) {
    .row {
      grid-template-columns: 52px minmax(0, 1fr);
      align-items: start;
    }
    .card {
      grid-column: 2;
      max-width: 420px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card,
    .n,
    .row {
      transition: none;
    }
  }
</style>
