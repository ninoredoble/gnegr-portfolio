---
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'work'>[];
  total: number;
}
const { items, total } = Astro.props;
const label: Record<CollectionEntry<'work'>['data']['kind'], string> = {
  product: 'PRODUCT',
  'ai-workflow': 'AI WORKFLOW',
  production: 'PRODUCTION',
  systems: 'SYSTEMS',
  study: 'STUDY',
};
---

<section class="wrap" id="work" aria-labelledby="work-h">
  <div class="head reveal">
    <h2 id="work-h" class="display">SELECTED WORK</h2>
    <a class="more" href="/lab/">{items.length} OF {total} · MORE IN THE LAB →</a>
  </div>
  <ol>
    {
      items.map((w, i) => (
        <li class="reveal" style={`--d:${(i * 0.07).toFixed(2)}s`}>
          <a class="row" href={`/work/${w.id}/`}>
            <span class="n display">{String(i + 1).padStart(2, '0')}</span>
            <span class="t display">{w.data.title.toUpperCase()}</span>
            <span class="d">{w.data.summary}</span>
            <span class="tag">{label[w.data.kind]}</span>
          </a>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    border-bottom: 3px solid var(--rosewood);
    padding-bottom: 12px;
  }
  h2 {
    font-size: clamp(44px, 6vw, 84px);
    line-height: 1;
  }
  .more {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--rosewood);
    text-decoration: none;
    padding: 12px 0;
  }
  .more:hover {
    color: var(--sakura);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: clamp(56px, 8vw, 120px) minmax(0, 1fr) minmax(0, 1.3fr) auto;
    gap: clamp(12px, 2vw, 28px);
    align-items: baseline;
    padding: clamp(16px, 2vw, 26px) 0;
    border-bottom: 1px solid var(--rosewood);
    color: var(--rosewood);
    text-decoration: none;
  }
  .n {
    font-size: clamp(44px, 5.4vw, 76px);
    line-height: 0.9;
    color: var(--sakura);
    transition: transform 0.35s var(--ease-out);
  }
  .t {
    font-size: clamp(34px, 4vw, 58px);
    line-height: 0.95;
    transition: color 0.2s;
  }
  .d {
    font-size: 18px;
    line-height: 1.45;
  }
  .tag {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    white-space: nowrap;
    transition: opacity 0.2s;
  }
  .row::after {
    content: '→';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translate(-12px, -50%);
    opacity: 0;
    font-size: 28px;
    color: var(--sakura);
    transition:
      opacity 0.25s,
      transform 0.35s var(--ease-out);
  }
  .row:hover .t,
  .row:focus-visible .t {
    color: var(--sakura);
  }
  .row:hover .n,
  .row:focus-visible .n {
    transform: translateX(8px);
  }
  .row:hover::after,
  .row:focus-visible::after {
    opacity: 1;
    transform: translate(0, -50%);
  }
  .row:hover .tag,
  .row:focus-visible .tag {
    opacity: 0;
  }
  @media (max-width: 1024px) {
    .row {
      grid-template-columns: clamp(56px, 9vw, 96px) minmax(0, 1fr) minmax(0, 1.4fr);
    }
    .tag {
      display: none;
    }
  }
  @media (max-width: 820px) {
    .row {
      grid-template-columns: 52px minmax(0, 1fr);
    }
    .d,
    .tag {
      grid-column: 2;
    }
    .tag {
      display: block;
    }
    .row::after {
      display: none;
    }
    .row:hover .tag {
      opacity: 1;
    }
  }
</style>
