---
// Proof points as paper tags on a string: tilted, they straighten and lift on hover.
// Every figure is sourced (BuyNaBay study, App Store listing, transcript).
const tags = [
  { big: 'LIVE', small: 'Kivora, on the App Store', href: '/work/kivora/' },
  { big: '87.45', small: 'BuyNaBay usability score, from 60 testers', href: '/work/buynabay/' },
  { big: '14/14', small: 'BuyNaBay critical tests passed', href: '/work/buynabay/' },
  { big: 'BS IT', small: 'Magna cum laude, USTP 2026', href: '/resume/' },
];
---

<section class="wrap proof" aria-label="Proof points">
  <svg class="string" viewBox="0 0 1200 40" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 8 C 300 40, 900 40, 1200 8" fill="none" stroke="#c46864" stroke-width="2.5"></path>
  </svg>
  <ul>
    {
      tags.map((t, i) => (
        <li class="reveal" style={`--d:${(i * 0.08).toFixed(2)}s; --tilt:${[-3, 2.5, -1.5, 3][i]}deg`}>
          <a href={t.href} class="tag">
            <span class="hole" aria-hidden="true" />
            <span class="big display">{t.big}</span>
            <span class="small">{t.small}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .proof {
    position: relative;
    padding-block: clamp(8px, 2vw, 24px) clamp(56px, 8vw, 104px);
  }
  .string {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    top: clamp(8px, 2vw, 24px);
    width: calc(100% - 2 * var(--gutter));
    height: 40px;
  }
  ul {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 18px 0 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(14px, 2.4vw, 32px);
  }
  li {
    /* drop-shadow follows the clipped tag shape (box-shadow would be clipped away) */
    filter: drop-shadow(0 12px 14px rgb(77 41 38 / 0.3));
  }
  .tag {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 100%;
    padding: 34px 20px 22px;
    background: var(--rosewood);
    color: var(--paper);
    text-decoration: none;
    transform: rotate(var(--tilt));
    transform-origin: 50% 0;
    clip-path: polygon(14% 0, 86% 0, 100% 12%, 100% 100%, 0 100%, 0 12%);
    transition: transform 0.45s var(--ease-out);
  }
  .tag:hover,
  .tag:focus-visible {
    transform: rotate(0deg) translateY(-6px);
  }
  /* the tag's clipped shape would hide a focus ring, so draw it on the list item */
  .tag:focus-visible {
    outline: none;
  }
  li:has(.tag:focus-visible) {
    outline: 3px solid var(--sakura);
    outline-offset: 6px;
  }
  .hole {
    position: absolute;
    top: 12px;
    left: 50%;
    width: 12px;
    height: 12px;
    margin-left: -6px;
    border-radius: 50%;
    background: var(--paper);
    box-shadow: 0 0 0 3px var(--sakura);
  }
  .big {
    font-size: clamp(40px, 5vw, 68px);
    line-height: 0.9;
  }
  .small {
    font-size: 15px;
    line-height: 1.4;
    font-weight: 500;
  }
  @media (max-width: 820px) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 28px;
    }
    .string {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tag {
      transition: none;
    }
  }
</style>
