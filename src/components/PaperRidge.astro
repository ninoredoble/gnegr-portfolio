---
// The landscape above the footer, cut from the hero's own art (scripts/build-footer-scene.mjs):
// the hero's sky, sun and mountains, a pine valley, then the footer's teal rising out of it.
// The palms, stilt house and eagle stand on the valley.
//
// Speed: the drawing is an <img>, so the browser paints it once and caches it. Only small
// separate pieces move (the clouds as one image, the eagle and the palms), and they move with
// transforms, which the GPU handles without redrawing the landscape.
import Ornament from './Ornament.astro';

interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<div class:list={['ridge', cls]} aria-hidden="true">
  <div class="box">
    <img class="land" src="/img/paper/footer-landscape.svg" alt="" width="1600" height="520" loading="lazy" decoding="async" />
    <img class="clouds" src="/img/paper/footer-clouds.svg" alt="" width="1600" height="520" loading="lazy" decoding="async" />
    <Ornament kind="palm" class="o palm-a" />
    <Ornament kind="palm" class="o palm-b" />
    <Ornament kind="house" class="o house" />
    <Ornament kind="palm" class="o palm-c" />
    <Ornament kind="eagle" class="o eagle" />
  </div>
</div>

<style>
  .ridge {
    position: relative;
    overflow: hidden;
    margin-bottom: -1px;
    background: var(--river);
  }
  /* A fixed-shape stage, so the ornaments always land on the same spot of the drawing. On
     narrow screens it stays at least 960px wide and the sides are cropped. */
  .box {
    position: relative;
    width: max(100%, 960px);
    left: 50%;
    translate: -50% 0;
    aspect-ratio: 1600 / 520;
    background: var(--paper);
  }
  .land,
  .clouds {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .ridge :global(.o) {
    position: absolute;
    height: auto;
  }
  /* Positions are fractions of the stage; the valley's top edge sits about 85% down. */
  .ridge :global(.palm-a) {
    left: 22%;
    bottom: 13.5%;
    width: 6.4%;
  }
  .ridge :global(.palm-b) {
    left: 27.5%;
    bottom: 13%;
    width: 4.8%;
    transform: scaleX(-1);
  }
  .ridge :global(.house) {
    left: 55%;
    bottom: 12.5%;
    width: 6.4%;
  }
  .ridge :global(.palm-c) {
    left: 71%;
    bottom: 13.5%;
    width: 5.8%;
  }
  .ridge :global(.eagle) {
    left: 30%;
    top: 38%;
    width: 5%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .clouds {
      animation: clouds 26s ease-in-out infinite alternate;
    }
    .ridge :global(.eagle) {
      animation: glide 11s ease-in-out infinite;
    }
    .ridge :global(.palm-a),
    .ridge :global(.palm-c) {
      transform-origin: 50% 100%;
      animation: sway 6s ease-in-out infinite;
    }
  }
  @keyframes clouds {
    from {
      transform: translateX(-1.2%);
    }
    to {
      transform: translateX(1.2%);
    }
  }
  @keyframes glide {
    0%,
    100% {
      translate: 0 0;
      rotate: 0deg;
    }
    50% {
      translate: 60% -20%;
      rotate: -3deg;
    }
  }
  @keyframes sway {
    0%,
    100% {
      rotate: 0deg;
    }
    50% {
      rotate: -2.5deg;
    }
  }
</style>
