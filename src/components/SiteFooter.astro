---
// Closing contact band shared by every page. "Email me" opens the in-site composer; LinkedIn,
// GitHub and Resume show a paper preview card on hover or keyboard focus.
import PaperRidge from './PaperRidge.astro';
import Icon from './Icon.astro';
import EmailDialog from './EmailDialog.astro';
import { LINKEDIN, GITHUB, GITHUB_USER } from '../data/contact';
import { githubCard } from '../data/github';

const gh = await githubCard();
---

<PaperRidge class="footer-ridge" />
<footer class="site-footer" id="contact">
  <div class="wrap inner">
    <h2 class="display reveal">SAY <span>HELLO.</span></h2>
    <div>
      <p class="reveal">
        Have an app or a website in mind? Tell me what you're trying to do and I'll tell you honestly how I'd approach
        it. I work with founders and teams anywhere, remotely, and I'm open to the right full-time role.
      </p>
      <div class="links reveal" style="--d:.08s">
        <button type="button" class="link solid" data-email-open>
          <Icon name="mail" size={20} />
          <span>Email me</span>
        </button>

        <span class="peek">
          <a class="link" href={LINKEDIN} target="_blank" rel="noopener">
            <Icon name="linkedin" size={20} />
            <span>LinkedIn</span>
          </a>
          <span class="card" aria-hidden="true">
            <span class="who">
              <img src={gh.avatar} alt="" width="56" height="56" loading="lazy" />
              <span>
                <strong>Niño Redoble</strong>
                <span>Product designer &amp; engineer</span>
              </span>
            </span>
            <span class="line">Co-founder, MixCortex</span>
            <span class="foot"><Icon name="linkedin" size={16} /> linkedin.com/in/g-redoble ↗</span>
          </span>
        </span>

        <span class="peek">
          <a class="link" href={GITHUB} target="_blank" rel="noopener">
            <Icon name="github" size={20} />
            <span>GitHub</span>
          </a>
          <span class="card" aria-hidden="true">
            <span class="who">
              <img src={gh.avatar} alt="" width="56" height="56" loading="lazy" />
              <span>
                <strong>@{GITHUB_USER}</strong>
                <span>{gh.repos !== null ? `${gh.repos} public repositories` : 'Code and studies'}</span>
              </span>
            </span>
            {
              gh.recent.length > 0 && (
                <span class="repos">
                  {gh.recent.map((r) => (
                    <span class="repo">{r}</span>
                  ))}
                </span>
              )
            }
            <span class="foot"><Icon name="github" size={16} /> github.com/{GITHUB_USER} ↗</span>
          </span>
        </span>

        <span class="peek right">
          <a class="link" href="/resume/">
            <Icon name="doc" size={20} />
            <span>Resume</span>
          </a>
          <span class="card resume-card" aria-hidden="true">
            <img class="sheet" src="/resume-preview.png" alt="" width="240" height="339" loading="lazy" />
            <span class="foot"><Icon name="doc" size={16} /> One page · PDF available</span>
          </span>
        </span>
      </div>
    </div>
  </div>
  <div class="wrap fine">
    <span>© 2026 Niño Redoble</span>
    <span class="clock" data-clock hidden></span>
    <a href="/colophon/">Colophon</a>
  </div>
</footer>
<EmailDialog />

<script>
  // "3:20 pm for me · GMT+8": my local time, so someone overseas can see my working hours.
  const el = document.querySelector<HTMLElement>('[data-clock]');
  if (el) {
    const fmt = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'Asia/Manila' });
    const tick = () => (el.textContent = `${fmt.format(new Date()).toLowerCase()} for me · GMT+8`);
    tick();
    el.hidden = false;
    setTimeout(() => {
      tick();
      setInterval(tick, 60_000);
    }, 60_000 - (Date.now() % 60_000));
  }
</script>

<style>
  :global(.footer-ridge) {
    margin-top: clamp(56px, 8vw, 112px);
  }
  .site-footer {
    background: var(--river);
    color: var(--paper);
  }
  .site-footer h2 {
    color: var(--paper);
  }
  .site-footer h2 span {
    color: var(--sun);
  }
  .inner {
    padding-block: clamp(56px, 8vw, 112px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 72px);
  }
  h2 {
    font-size: clamp(56px, 9vw, 140px);
    line-height: 0.85;
  }
  p {
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.55;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }
  .link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 14px;
    white-space: nowrap;
    border: 2px solid var(--paper);
    background: transparent;
    color: var(--paper);
    font: inherit;
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    cursor: pointer;
    --icon-cut: var(--river);
    transition:
      background-color 0.2s,
      border-color 0.2s,
      color 0.2s,
      transform 0.2s;
  }
  .link.solid {
    background: var(--paper);
    color: var(--river);
    --icon-cut: var(--paper);
  }
  .link:hover {
    background: var(--sun);
    border-color: var(--sun);
    color: var(--ink);
    --icon-cut: var(--sun);
    transform: translateY(-2px);
  }
  .link:active {
    transform: translateY(0);
  }
  .link:focus-visible {
    outline: 3px solid var(--sun);
    outline-offset: 3px;
  }

  /* Hover preview: a paper card that lifts out above the link. Only on devices that can hover. */
  .peek {
    position: relative;
    display: inline-flex;
  }
  .card {
    display: none;
  }
  @media (hover: hover) {
    .card {
      position: absolute;
      left: 0;
      bottom: calc(100% + 14px);
      z-index: 5;
      display: flex;
      flex-direction: column;
      gap: 10px;
      width: 280px;
      padding: 16px;
      background: var(--paper);
      color: var(--ink);
      box-shadow: 0 18px 36px rgb(16 32 34 / 0.45);
      opacity: 0;
      visibility: hidden;
      transform: translateY(10px) rotate(-2deg);
      transform-origin: 20% 100%;
      transition:
        opacity 0.2s,
        transform 0.35s var(--ease-out),
        visibility 0s 0.35s;
      pointer-events: none;
    }
    .peek.right .card {
      left: auto;
      right: 0;
      transform-origin: 80% 100%;
    }
    .peek:hover .card,
    .peek:focus-within .card {
      opacity: 1;
      visibility: visible;
      transform: translateY(0) rotate(-1deg);
      transition:
        opacity 0.2s,
        transform 0.35s var(--ease-out),
        visibility 0s;
    }
  }
  .card::after {
    content: '';
    position: absolute;
    left: 28px;
    bottom: -8px;
    width: 16px;
    height: 16px;
    background: var(--paper);
    transform: rotate(45deg);
  }
  .peek.right .card::after {
    left: auto;
    right: 28px;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .who img {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 2px solid var(--river-ink);
    object-fit: cover;
    flex: none;
  }
  .who > span {
    display: flex;
    flex-direction: column;
    font-size: 15px;
    line-height: 1.35;
  }
  .who strong {
    font-size: 17px;
  }
  .line {
    font-size: 14px;
    line-height: 1.4;
  }
  .repos {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .repo {
    padding: 2px 8px;
    background: color-mix(in oklab, var(--sage) 28%, var(--paper));
    font-size: 13px;
  }
  .foot {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-top: 8px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    font-weight: 700;
    color: var(--river-ink);
  }
  .resume-card {
    width: 260px;
  }
  .sheet {
    display: block;
    width: 100%;
    height: auto;
    background: #fff;
    box-shadow: 0 4px 12px rgb(62 44 32 / 0.25);
  }

  .fine {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    /* bottom room so the dock never covers the last line */
    padding-block: 18px 104px;
    border-top: 1px solid color-mix(in oklab, var(--paper) 30%, var(--river));
    font-size: 14px;
  }
  .clock {
    color: color-mix(in oklab, var(--paper) 78%, var(--river));
    font-variant-numeric: tabular-nums;
  }
  .fine a {
    color: var(--paper);
    text-underline-offset: 3px;
    padding: 12px 0;
    margin: -12px 0;
  }
  .fine a:hover {
    text-decoration-thickness: 3px;
  }
  @media (max-width: 820px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  /* Too narrow for a 280px card beside the buttons: it would run off the page. */
  @media (max-width: 600px) {
    .card {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card,
    .link {
      transition: none !important;
    }
  }
</style>
