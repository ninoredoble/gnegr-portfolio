---
// Closing contact band shared by every page.
import { CONTACT } from '../data/contact';
---

<footer class="site-footer" id="contact">
  <div class="wrap inner">
    <h2 class="display reveal">SAY HELLO.</h2>
    <div>
      <p class="reveal">
        Have an app or a website in mind? Tell me what you're trying to do and I'll tell you honestly how I'd approach
        it. I'm based in Cagayan de Oro, and I'm also open to the right full-time role.
      </p>
      <div class="links reveal" style="--d:.08s">
        {CONTACT.map((c) => <a href={c.href}>{c.label}</a>)}
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(72px, 10vw, 140px);
    background: var(--rosewood);
    color: var(--paper);
  }
  .inner {
    padding-block: clamp(56px, 8vw, 112px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 72px);
  }
  h2 {
    font-size: clamp(56px, 9vw, 140px);
    line-height: 0.85;
  }
  p {
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.55;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 22px;
    border: 2px solid var(--paper);
    color: var(--paper);
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color 0.2s,
      border-color 0.2s,
      transform 0.2s;
  }
  .links a:first-child {
    background: var(--paper);
    color: var(--rosewood);
  }
  .links a:hover {
    background: var(--sakura);
    border-color: var(--sakura);
    color: var(--paper);
    transform: translateY(-2px);
  }
  @media (max-width: 820px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
