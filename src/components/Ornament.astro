---
// Paper-cut Mindanao ornaments in the three brand colours, with a soft paper shadow:
// the vinta, a coconut palm, a stilt house and the Philippine eagle from the hero.
interface Props {
  kind: 'vinta' | 'palm' | 'house' | 'eagle';
  class?: string;
  style?: string;
}
const { kind, class: cls, style } = Astro.props;
const R = '#7b3e3b';
const S = '#c46864';
const P = '#fdf6eb';
const views = { vinta: '-110 -125 230 150', palm: '-75 -175 150 180', house: '-60 -78 120 98', eagle: '-56 -32 112 44' };
---

<svg class:list={['orn', `orn-${kind}`, cls]} {style} viewBox={views[kind]} aria-hidden="true" focusable="false">
  {
    kind === 'vinta' && (
      <g>
        <path fill={R} d="M -96 -10 L 112 -10 C 104 6 70 14 10 14 C -50 14 -84 6 -96 -10 Z" />
        <path stroke={R} stroke-width="4" fill="none" d="M -70 -6 L -82 20 L 92 20 L 80 -6" />
        <path stroke={R} stroke-width="4" d="M -4 -12 L -36 -118" />
        <clipPath id="orn-sail">
          <path d="M -6 -16 L -32 -116 C 6 -124 48 -118 78 -100 L 66 -16 Z" />
        </clipPath>
        <g clip-path="url(#orn-sail)">
          <rect x="-40" y="-130" width="24" height="120" fill={S} />
          <rect x="-16" y="-130" width="20" height="120" fill={P} />
          <rect x="4" y="-130" width="22" height="120" fill={R} />
          <rect x="26" y="-130" width="20" height="120" fill={P} />
          <rect x="46" y="-130" width="40" height="120" fill={S} />
        </g>
        <path stroke={R} stroke-width="3" fill="none" d="M -32 -116 C 6 -124 48 -118 78 -100 L 66 -16 L -6 -16 Z" />
      </g>
    )
  }
  {
    kind === 'palm' && (
      <g>
        <path fill={R} d="M -5 0 C -3 -50 6 -100 20 -150 L 28 -148 C 16 -100 8 -50 5 0 Z" />
        <g transform="translate(24 -150)" fill={R}>
          <path d="M0 0 C 22 -12 54 -10 74 12 C 48 2 24 2 0 5 Z" />
          <path d="M0 0 C -22 -14 -54 -12 -72 8 C -46 0 -22 0 0 5 Z" />
          <path fill={S} d="M0 0 C 16 -26 42 -36 66 -30 C 40 -24 20 -12 0 3 Z" />
          <path fill={S} d="M0 0 C -14 -28 -38 -40 -62 -36 C -36 -26 -16 -14 0 3 Z" />
          <path d="M0 0 C 28 4 48 24 52 44 C 36 24 18 12 0 5 Z" />
          <path d="M0 0 C -26 6 -42 26 -44 46 C -30 26 -14 14 0 5 Z" />
          <circle cx="-5" cy="8" r="5.5" fill={P} />
          <circle cx="6" cy="9" r="5.5" fill={P} />
        </g>
      </g>
    )
  }
  {
    kind === 'house' && (
      <g>
        <rect x="-40" y="-6" width="5" height="26" fill={R} />
        <rect x="35" y="-6" width="5" height="26" fill={R} />
        <rect x="-2" y="-6" width="4" height="26" fill={R} />
        <rect x="-44" y="-10" width="88" height="6" fill={R} />
        <rect x="-36" y="-44" width="72" height="36" fill={R} />
        <rect x="-26" y="-36" width="16" height="14" fill={P} />
        <rect x="8" y="-36" width="18" height="28" fill={S} />
        <path fill={S} d="M -54 -40 L 0 -76 L 54 -40 Z" />
        <g stroke={P} stroke-width="2" opacity="0.7">
          <path d="M -30 -46 L 0 -66" />
          <path d="M -10 -46 L 6 -60" />
          <path d="M 14 -46 L 22 -54" />
        </g>
      </g>
    )
  }
  {
    kind === 'eagle' && (
      <g>
        <path fill={R} d="M -4 -2 C -16 -10 -30 -18 -48 -22 L -44 -18 L -52 -16 L -44 -13 L -50 -9 L -40 -8 C -28 -6 -16 -2 -6 2 Z" />
        <path fill={R} d="M 4 -2 C 14 -12 26 -22 42 -28 L 39 -23 L 47 -22 L 39 -18 L 45 -14 L 35 -13 C 24 -8 14 -3 6 2 Z" />
        <path fill={S} d="M -8 0 C -18 -6 -28 -10 -38 -12 L -34 -9 C -24 -6 -16 -3 -8 2 Z M 8 0 C 16 -7 24 -12 32 -16 L 30 -12 C 22 -8 15 -4 8 2 Z" />
        <path fill={R} d="M -16 -1 C -10 -5 6 -5 14 -2 L 24 -5 L 26 0 L 24 5 L 14 2 C 6 5 -10 5 -16 1 Z" />
        <circle cx="-17" cy="-1" r="4.4" fill={P} />
        <path fill={R} d="M -21 -1 C -24 -1 -26 1 -25 3 L -21 1 Z" />
      </g>
    )
  }
</svg>

<style>
  .orn {
    display: block;
    overflow: visible;
    filter: drop-shadow(0 4px 3px rgb(77 41 38 / 0.22));
  }
</style>
