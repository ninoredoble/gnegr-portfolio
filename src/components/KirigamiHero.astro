---
// The home hero: the KIRIGAMI paper diorama (MIT, see src/kirigami/LICENSE.md), unchanged
// art, plus our Mindanao additions. React hydrates the server-rendered markup below, so it
// must stay byte-for-byte what scripts/extract-kirigami.mjs wrote.
import scene from '../kirigami/scene.html?raw';
import SiteNav from './SiteNav.astro';

interface Props {
  name: string;
  tagline: string;
  nav: { href: string; label: string }[];
}
const { name, tagline, nav } = Astro.props;
const [first, ...rest] = name.split(' ');
---

<section class="hero" aria-label="Introduction">
  <div id="standalone-root" style="display:contents" set:html={scene} />

  <div class="overlay">
    <SiteNav links={nav} />
    <div class="foot">
      <div class="id">
        <p class="tagline">{tagline}</p>
        <h1 class="name display">
          <span class="w">{first}</span> <span class="w">{rest.join(' ')}</span>
        </h1>
      </div>
      <a class="scroll" href="#about">SCROLL ↓</a>
    </div>
  </div>
</section>

<script is:inline defer src="/kirigami/kirigami.js"></script>
<script is:inline defer src="/kirigami/mindanao.js"></script>
<script>
  // Reveal the scene once React has hydrated and folded it for the opening unfold, so the
  // unfolded server render never snaps shut on screen. Failsafe: show it after 1.5 s anyway.
  const ready = () => document.body.classList.add('scene-ready');
  const onReady = () => requestAnimationFrame(() => requestAnimationFrame(ready));
  if ((window as { __kirigamiReady?: boolean }).__kirigamiReady) onReady();
  else addEventListener('kirigami:ready', onReady, { once: true });
  setTimeout(ready, 1500);
</script>

<style is:global>
  /* The scene's own elements. Its 450 KB template stylesheet is not shipped; these few
     rules replace the utilities its markup used. */
  #standalone-root > main {
    position: relative;
    z-index: 0;
    /* svh, not dvh: a phone's address bar showing or hiding must not resize the scene. */
    height: 100svh;
    width: 100%;
    overflow: hidden;
    isolation: isolate;
  }
  /* Clouds and houses stay clickable, without a focus box or a tap highlight. */
  .kirigami-stage,
  .kirigami-stage * {
    -webkit-tap-highlight-color: transparent;
  }
  .kirigami-svg-root [role='button'],
  .kirigami-svg-root [role='button']:focus,
  .kirigami-svg-root [role='button']:focus-visible {
    outline: none;
  }
  .kirigami-svg-root {
    display: block;
  }
  .kirigami-stage {
    transition: opacity 0.5s ease;
  }
  .js body:not(.scene-ready) .kirigami-stage {
    opacity: 0;
    animation: scene-failsafe 0s 3s forwards;
  }
  @keyframes scene-failsafe {
    to {
      opacity: 1;
    }
  }
</style>

<style>
  .hero {
    position: relative;
  }
  .overlay {
    position: absolute;
    inset: 0 0 auto 0;
    height: 100svh;
    /* no z-index: it would trap the menu (z 60) under the page content (z 2) */
    pointer-events: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(16px, 3vw, 40px);
  }
  .overlay a {
    pointer-events: auto;
  }
  .foot {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
  }
  .name {
    color: var(--rosewood);
    font-size: clamp(64px, 15.5vw, 250px);
    line-height: 0.92;
    letter-spacing: -0.005em;
    /* clips the rise-in; padding leaves room for Empanada's tall ñ and descent */
    overflow: hidden;
    padding: 0.2em 0 0.06em;
    margin-bottom: -0.06em;
    text-shadow:
      0 2px 0 var(--paper),
      0 6px 18px rgb(77 41 38 / 0.18);
  }
  .w {
    display: inline-block;
  }
  .tagline {
    display: inline-block;
    margin-bottom: 10px;
    padding: 6px 12px;
    background: var(--rosewood);
    color: var(--paper);
    font-size: clamp(13px, 1.3vw, 16px);
    font-weight: 700;
    letter-spacing: 0.06em;
    box-shadow: 0 4px 0 rgb(77 41 38 / 0.25);
  }
  .scroll {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--paper);
    background: var(--rosewood);
    padding: 10px 14px;
    text-decoration: none;
  }

  /* Entrance: the name rises once the paper has mostly unfolded. */
  :global(.js) .w {
    transform: translateY(105%);
    opacity: 0;
    animation: rise 1s var(--ease-out) 1.1s forwards;
  }
  :global(.js) .w + .w {
    animation-delay: 1.24s;
  }
  :global(.js) .overlay > :global(.site-nav),
  :global(.js) .scroll,
  :global(.js) .tagline {
    opacity: 0;
    animation: fade 0.8s ease 1.6s forwards;
  }
  @keyframes rise {
    to {
      transform: none;
      opacity: 1;
    }
  }
  @keyframes fade {
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .w,
    :global(.js) .overlay > :global(.site-nav),
    :global(.js) .scroll,
    :global(.js) .tagline {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 600px) {
    .scroll {
      display: none;
    }
    .name {
      font-size: clamp(60px, 22vw, 116px);
      line-height: 0.92;
    }
    .overlay {
      padding-bottom: max(20px, env(safe-area-inset-bottom));
    }
  }
</style>
