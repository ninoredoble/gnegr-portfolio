---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import WeaveBand from '../../components/WeaveBand.astro';
import { Image, Picture } from 'astro:assets';

export async function getStaticPaths() {
  const all = await getCollection('work');
  const featured = all.filter((w) => w.data.featured).sort((a, b) => (a.data.featured ?? 0) - (b.data.featured ?? 0));
  const lab = all.filter((w) => !w.data.featured && w.data.page);
  return [
    ...featured.map((entry, i) => ({
      params: { id: entry.id },
      props: { entry, next: featured[(i + 1) % featured.length], index: i },
    })),
    // Lab entries with their own page: no number, and "next" leads back to the featured work.
    ...lab.map((entry) => ({ params: { id: entry.id }, props: { entry, next: featured[0], index: -1 } })),
  ];
}

interface Props {
  entry: CollectionEntry<'work'>;
  next: CollectionEntry<'work'>;
  index: number;
}
const { entry, next, index } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const kindLabel = {
  product: 'Product',
  process: 'Process',
  production: 'Production',
  systems: 'Systems',
  study: 'Study',
}[d.kind];
---

<Base title={`${d.title} · Niño Redoble`} description={d.summary}>
  <SiteHeader />
  <main id="main">
    <article>
      <header class="wrap head">
        <p class="eyebrow">
          <span>{index >= 0 ? String(index + 1).padStart(2, '0') : 'LAB'}</span>
          <span>{kindLabel.toUpperCase()}</span>
        </p>
        <h1 class="display title reveal">{d.title.toUpperCase()}</h1>
        <p class="lede reveal" style="--d:.08s">{d.summary}</p>
      </header>

      {
        d.cover && (
          <figure class="wrap cover reveal">
            <Picture src={d.cover.src} alt={d.cover.alt} widths={[640, 1100, 1600, 2200]} sizes="(max-width: 1280px) 100vw, 1280px" formats={['avif', 'webp']} fallbackFormat="jpg" width={2200} loading="eager" fetchpriority="high" />
          </figure>
        )
      }

      <WeaveBand height={20} />

      <div class="wrap grid">
        <aside class="meta" aria-label="Project details">
          <dl>
            <div><dt>Role</dt><dd>{d.role}</dd></div>
            <div><dt>When</dt><dd>{d.period}</dd></div>
            <div><dt>Status</dt><dd>{d.status}</dd></div>
            <div>
              <dt>Stack</dt>
              <dd><ul>{d.stack.map((s) => <li>{s}</li>)}</ul></dd>
            </div>
            {d.credit && <div><dt>Credit</dt><dd>{d.credit}</dd></div>}
            {
              d.org && (
                <div>
                  <dt>Built at</dt>
                  <dd>
                    {d.org.logo ? (
                      <a class="org" href={d.org.href}>
                        <Image src={d.org.logo} alt={d.org.name} height={26} />
                      </a>
                    ) : (
                      d.org.name
                    )}
                  </dd>
                </div>
              )
            }
          </dl>
          {
            (d.links || d.live || d.repo) && (
              <div class="actions">
                {d.links?.map((l) => <a class:list={['btn', l.primary ? 'solid' : 'line']} href={l.href}>{l.label} ↗</a>)}
                {d.live && <a class="btn solid" href={d.live}>Open live ↗</a>}
                {d.repo && <a class="btn line" href={d.repo}>Source ↗</a>}
              </div>
            )
          }
        </aside>

        <div class="prose">
          <Content />
        </div>
      </div>

      {
        d.screens && (
          <section class="screens" aria-label="App screens">
            <ul class="wrap">
              {d.screens.map((sc, i) => (
                <li class="reveal" style={`--d:${(i * 0.06).toFixed(2)}s`}>
                  <Picture src={sc.src} alt={sc.alt} widths={[320, 480, 720]} sizes="(max-width: 820px) 70vw, 300px" formats={['avif', 'webp']} fallbackFormat="jpg" width={720} />
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        d.shots && (
          <section class="wrap shots" aria-label="Screens">
            {d.shots.map((sh, i) => (
              <figure class:list={['reveal', { wide: sh.wide }]} style={`--d:${(i * 0.06).toFixed(2)}s`}>
                <div class:list={[{ browser: sh.frame, plain: !sh.frame }]}>
                  {sh.frame && (
                    <div class="bar" aria-hidden="true">
                      <span class="dots"><i></i><i></i><i></i></span>
                    </div>
                  )}
                  <Picture src={sh.src} alt={sh.alt} widths={sh.wide ? [640, 1100, 1600, 2200] : [480, 800, 1200]} sizes={sh.wide ? '(max-width: 1280px) 100vw, 1200px' : '(max-width: 820px) 100vw, 620px'} formats={['avif', 'webp']} fallbackFormat="jpg" width={sh.wide ? 2200 : 1200} />
                </div>
                <figcaption>{sh.caption}</figcaption>
              </figure>
            ))}
          </section>
        )
      }

      {
        d.preview && (
          <figure class="wrap preview reveal">
            <div class="browser">
              <div class="bar" aria-hidden="true">
                <span class="dots"><i></i><i></i><i></i></span>
                <span class="url">{d.preview.url}</span>
              </div>
              <Picture src={d.preview.src} alt={d.preview.alt} widths={[640, 1100, 1600]} sizes="(max-width: 1280px) 100vw, 1200px" formats={['avif', 'webp']} fallbackFormat="jpg" width={1600} />
            </div>
            <figcaption>
              <a href={`https://${d.preview.url}`}>Visit {d.preview.url} ↗</a>
            </figcaption>
          </figure>
        )
      }

      <nav class="wrap next" aria-label="Next case study">
        <a href={`/work/${next.id}/`}>
          <span class="label">NEXT</span>
          <span class="display name">{next.data.title.toUpperCase()} →</span>
        </a>
      </nav>
    </article>
  </main>
  <SiteFooter />
</Base>

<style>
  .head {
    padding-block: clamp(32px, 6vw, 88px) clamp(28px, 4vw, 56px);
  }
  .eyebrow {
    display: flex;
    gap: 16px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin-bottom: 12px;
  }
  .eyebrow span:first-child {
    color: var(--rosewood);
  }
  .title {
    font-size: clamp(60px, 12vw, 180px);
    line-height: 0.84;
    overflow-wrap: anywhere;
  }
  .lede {
    margin-top: 20px;
    max-width: 34em;
    font-size: clamp(19px, 1.9vw, 24px);
    line-height: 1.45;
  }
  .cover {
    margin: 0 auto clamp(28px, 4vw, 48px);
  }
  .cover :global(img),
  .screens :global(img),
  .preview :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .org {
    display: inline-block;
    padding: 4px 0;
  }
  .org :global(img) {
    display: block;
    width: auto;
  }
  .screens {
    padding-block: clamp(16px, 3vw, 40px);
  }
  .screens ul {
    list-style: none;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(12px, 2vw, 24px);
  }
  .screens li {
    box-shadow: 0 10px 24px rgb(77 41 38 / 0.18);
  }
  .preview {
    margin: clamp(32px, 5vw, 64px) auto 0;
  }
  .shots {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 3vw, 32px);
    padding-block: clamp(16px, 3vw, 40px);
  }
  .shots figure {
    margin: 0;
  }
  .shots figure.wide {
    grid-column: 1 / -1;
  }
  .plain {
    box-shadow: 0 10px 24px rgb(77 41 38 / 0.18);
  }
  .shots :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .shots figcaption {
    margin-top: 10px;
    font-size: 15px;
    line-height: 1.45;
  }
  @media (max-width: 820px) {
    .shots {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .browser {
    border: 2px solid var(--rosewood);
    box-shadow: 0 10px 24px rgb(77 41 38 / 0.18);
    background: var(--paper);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 14px;
    border-bottom: 2px solid var(--rosewood);
    font-size: 13px;
    font-weight: 500;
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid var(--rosewood);
  }
  .url {
    padding: 2px 10px;
    border: 1px solid var(--rosewood);
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .preview figcaption {
    margin-top: 12px;
    font-weight: 700;
  }
  .preview figcaption a {
    color: var(--rosewood);
    text-decoration-color: var(--sakura);
    text-underline-offset: 3px;
  }
  @media (max-width: 820px) {
    .screens ul {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 16px;
    }
    .screens li {
      flex: 0 0 62%;
      scroll-snap-align: start;
    }
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
    gap: clamp(28px, 6vw, 96px);
    padding-block: clamp(40px, 6vw, 80px);
    align-items: start;
  }
  .meta {
    position: sticky;
    top: 24px;
  }
  dl {
    margin: 0;
  }
  dl > div {
    padding: 12px 0;
    border-top: 1px solid var(--rosewood);
  }
  dt {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  dd {
    margin: 0;
    font-size: 16px;
    line-height: 1.45;
  }
  dd ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  dd li {
    padding: 2px 8px;
    border: 1px solid var(--rosewood);
    font-size: 14px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }
  .actions .btn {
    min-height: 48px;
    font-size: 16px;
    padding: 0 18px;
  }
  .btn.solid {
    background: var(--rosewood);
    border-color: var(--rosewood);
    color: var(--paper);
  }
  .btn.solid:hover {
    background: var(--sakura);
    border-color: var(--sakura);
  }
  .btn.line {
    color: var(--rosewood);
  }
  .btn.line:hover {
    color: var(--sakura);
  }

  /* Case study body */
  .prose {
    max-width: 42em;
    font-size: clamp(18px, 1.5vw, 20px);
    line-height: 1.65;
  }
  .prose :global(h2) {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(36px, 4.4vw, 60px);
    line-height: 0.95;
    margin: 1.6em 0 0.5em;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(h3) {
    font-size: 1em;
    font-weight: 700;
    margin: 1.4em 0 0.3em;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1em;
  }
  .prose :global(li) {
    margin-bottom: 0.4em;
  }
  .prose :global(a) {
    color: var(--rosewood);
    text-decoration-color: var(--sakura);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .prose :global(a:hover) {
    color: var(--sakura);
  }
  .prose :global(strong) {
    font-weight: 700;
  }
  .prose :global(code) {
    font-size: 0.88em;
    padding: 0 4px;
    border: 1px solid var(--rosewood);
  }
  .prose :global(blockquote) {
    margin: 1.4em 0;
    padding-left: 20px;
    border-left: 4px solid var(--sakura);
    font-size: 1.1em;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 1.2em;
    font-size: 0.9em;
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 8px 10px 8px 0;
    border-bottom: 1px solid var(--rosewood);
    vertical-align: top;
  }

  .next {
    padding-block: clamp(24px, 4vw, 48px) 0;
  }
  .next a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 20px;
    border-top: 3px solid var(--rosewood);
    color: var(--rosewood);
    text-decoration: none;
  }
  .next .label {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .next .name {
    font-size: clamp(40px, 7vw, 96px);
    line-height: 0.9;
    transition:
      color 0.2s,
      transform 0.3s var(--ease-out);
  }
  .next a:hover .name {
    color: var(--sakura);
    transform: translateX(8px);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .meta {
      position: static;
    }
  }
</style>
