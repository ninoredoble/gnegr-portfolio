---
import { getCollection, render } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import WeaveBand from '../components/WeaveBand.astro';

const lab = (await getCollection('work'))
  .filter((w) => !w.data.featured)
  .sort((a, b) => Number(!!b.data.live) - Number(!!a.data.live) || a.data.title.localeCompare(b.data.title));
const rendered = await Promise.all(lab.map(async (w) => ({ w, Content: (await render(w)).Content })));
---

<Base title="Lab · Niño Redoble" description="Smaller studies: interactive pages built to understand something, each labelled for what it is and isn't.">
  <SiteHeader />
  <main id="main">
    <header class="wrap head">
      <h1 class="display reveal">THE LAB</h1>
      <p class="lede reveal" style="--d:.08s">
        Smaller studies. Each one is an interactive page I built to understand something, and each says plainly what's real
        and what's sample data.
      </p>
    </header>
    <WeaveBand height={20} />
    <ol class="wrap list">
      {
        rendered.map(({ w, Content }, i) => (
          <li class="item reveal" style={`--d:${(i * 0.05).toFixed(2)}s; --tilt:${i % 2 ? 1.2 : -1.2}deg; --ac: ${['var(--river-mid)', 'var(--sage-ink)', 'var(--sun)', 'var(--olive)', 'var(--sakura)', 'var(--wood)'][i % 6]}`}>
            {(w.data.thumb || w.data.cover) && (
              <a class="shot" href={w.data.live ?? `/work/${w.id}/`} tabindex="-1" aria-hidden="true">
                <Picture src={w.data.thumb ?? w.data.cover!.src} alt="" widths={[360, 640, 900]} sizes="(max-width: 820px) 92vw, 46vw" formats={['avif', 'webp']} fallbackFormat="jpg" width={900} />
                <span class="open">{w.data.live ? 'Open live ↗' : 'Read more →'}</span>
              </a>
            )}
            <div class="top">
              <h2 class="display">{w.data.title.toUpperCase()}</h2>
              <p class="status">{w.data.status}</p>
            </div>
            <p class="summary">{w.data.summary}</p>
            <div class="body">
              {w.data.page ? <p>{w.data.excerpt}</p> : <Content />}
            </div>
            {w.data.credit && !w.data.page && <p class="credit">{w.data.credit}</p>}
            <div class="foot">
              <ul class="stack">
                {w.data.stack.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
              <div class="links">
                {w.data.page && <a href={`/work/${w.id}/`}>Read the case study →</a>}
                {w.data.live && <a href={w.data.live}>Open live ↗</a>}
                {w.data.repo && <a href={w.data.repo}>Source ↗</a>}
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </main>
  <SiteFooter />
</Base>

<style>
  .head {
    padding-block: clamp(32px, 6vw, 88px) clamp(28px, 4vw, 56px);
  }
  h1 {
    font-size: clamp(72px, 14vw, 200px);
    line-height: 0.84;
  }
  .lede {
    margin-top: 20px;
    max-width: 34em;
    font-size: clamp(19px, 1.9vw, 24px);
    line-height: 1.45;
  }
  .list {
    list-style: none;
    margin: 0 auto;
    padding-top: clamp(24px, 4vw, 48px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(24px, 4vw, 56px);
  }
  .item {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px 0 32px;
    border-top: 6px solid var(--ac);
  }
  /* The preview: a paper print of the live page. Straightens and lifts on hover. */
  .shot {
    position: relative;
    display: block;
    margin-bottom: 10px;
    border: 6px solid var(--paper);
    outline: 2px solid color-mix(in oklab, var(--ac) 55%, var(--ink));
    background: var(--paper);
    transform: rotate(var(--tilt));
    filter: drop-shadow(0 10px 14px rgb(62 44 32 / 0.2));
    transition:
      transform 0.45s var(--ease-out),
      filter 0.3s;
  }
  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
  }
  .shot .open {
    position: absolute;
    right: 10px;
    bottom: 10px;
    padding: 6px 12px;
    background: var(--ink);
    color: var(--paper);
    font-size: 13px;
    font-weight: 700;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.2s,
      transform 0.3s var(--ease-out);
  }
  .shot:hover {
    transform: rotate(0deg) translateY(-6px);
    filter: drop-shadow(0 18px 22px rgb(62 44 32 / 0.28));
  }
  .shot:hover .open {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .shot,
    .shot .open {
      transition: none;
    }
  }
  .top {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  h2 {
    font-size: clamp(38px, 4.6vw, 64px);
    line-height: 0.92;
  }
  .status {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }
  .summary {
    font-size: 19px;
    line-height: 1.45;
    font-weight: 500;
  }
  .body :global(p) {
    margin: 0;
    font-size: 17px;
    line-height: 1.55;
  }
  .credit {
    font-size: 15px;
    line-height: 1.5;
    padding: 10px 12px;
    background: color-mix(in oklab, var(--ac) 12%, var(--paper));
  }
  .foot {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-top: 8px;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stack li {
    padding: 3px 9px;
    background: color-mix(in oklab, var(--ac) 16%, var(--paper));
    font-size: 13px;
  }
  .links {
    display: flex;
    gap: 8px;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border: 2px solid var(--ink);
    color: var(--ink);
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
  }
  .links a:first-child {
    background: var(--rosewood);
    color: var(--paper);
  }
  .links a:hover {
    background: var(--river);
    border-color: var(--river);
    color: var(--paper);
  }
  .links a:active {
    transform: translateY(1px);
  }
  @media (max-width: 820px) {
    .list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
