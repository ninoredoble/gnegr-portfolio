---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import KirigamiHero from '../components/KirigamiHero.astro';
import WorkList from '../components/WorkList.astro';

const all = await getCollection('work');
const featured = all
  .filter((w) => w.data.featured)
  .sort((a, b) => (a.data.featured ?? 0) - (b.data.featured ?? 0));
// Featured five plus the seven Lab studies (BRIEF.md §5); Lab entries arrive in M3.
const LAB_COUNT = 7;

const nav = [
  { href: '#work', label: 'WORK' },
  { href: '/lab/', label: 'LAB' },
  { href: '#about', label: 'ABOUT' },
  { href: '/resume/', label: 'RESUME' },
  { href: '#contact', label: 'CONTACT' },
];
---

<Base>
  <KirigamiHero name="NIÑO REDOBLE" nav={nav} />

  <svg class="band" viewBox="0 0 1440 36" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <pattern id="weave" width="36" height="36" patternUnits="userSpaceOnUse">
        <rect width="36" height="36" fill="#7b3e3b"></rect>
        <path d="M18 3 L33 18 L18 33 L3 18 Z" fill="#c46864"></path>
        <path d="M18 11 L25 18 L18 25 L11 18 Z" fill="#fdf6eb"></path>
      </pattern>
    </defs>
    <rect width="1440" height="36" fill="url(#weave)"></rect>
  </svg>

  <div class="page">
    <section class="wrap intro" id="intro">
      <h2 class="display reveal">I DESIGN, BUILD AND RUN SOFTWARE. <em>LATELY WITH A CREW OF AI AGENTS.</em></h2>
      <div class="reveal" style="--d:.1s">
        <p>
          AI product engineer and co-founder of MixCortex, where I'm building Kivora. I take a product from the first
          sketch to the server it runs on, and I direct AI agents to do more of that work than one person could alone.
        </p>
        <div class="ctas">
          <a class="btn solid" href="#work">See the work</a>
          <a class="btn line" href="#contact">Get in touch</a>
        </div>
      </div>
    </section>

    <WorkList items={featured} total={featured.length + LAB_COUNT} />

    <section class="about" id="about">
      <div class="wrap about-inner" id="contact">
        <h2 class="display reveal">SAY HELLO.</h2>
        <div>
          <p class="reveal">
            I started on production systems for a power utility, then co-founded MixCortex to build Kivora. I do the
            design, the code and the operations, and I'm open to select roles and contracts.
          </p>
          <div class="links reveal" style="--d:.08s">
            <a href="mailto:[[confirm-email]]">Email me</a>
            <a href="https://linkedin.com/in/g-redoble">LinkedIn</a>
            <a href="https://github.com/ninoredoble">GitHub</a>
            <a href="/resume.pdf">Resume (PDF)</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .band {
    position: relative;
    z-index: 2;
    display: block;
    width: 100%;
    height: 36px;
  }
  .page {
    position: relative;
    z-index: 2;
    background: var(--paper);
  }
  .intro {
    padding-block: clamp(64px, 10vw, 140px) clamp(48px, 7vw, 96px);
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: end;
  }
  .intro h2 {
    font-size: clamp(48px, 7.6vw, 118px);
    line-height: 0.88;
  }
  .intro em {
    font-style: normal;
    color: var(--sakura);
  }
  .intro p,
  .about p {
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.55;
    margin-bottom: 24px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .btn.solid {
    background: var(--rosewood);
    border-color: var(--rosewood);
    color: var(--paper);
  }
  .btn.solid:hover {
    background: var(--sakura);
    border-color: var(--sakura);
  }
  .btn.line {
    color: var(--rosewood);
  }
  .btn.line:hover {
    color: var(--sakura);
  }
  .about {
    margin-top: clamp(72px, 10vw, 140px);
    background: var(--rosewood);
    color: var(--paper);
  }
  .about-inner {
    padding-block: clamp(56px, 8vw, 112px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 72px);
  }
  .about h2 {
    font-size: clamp(56px, 9vw, 140px);
    line-height: 0.85;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 22px;
    border: 2px solid var(--paper);
    color: var(--paper);
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color 0.2s,
      border-color 0.2s,
      transform 0.2s;
  }
  .links a:first-child {
    background: var(--paper);
    color: var(--rosewood);
  }
  .links a:hover {
    background: var(--sakura);
    border-color: var(--sakura);
    color: var(--paper);
    transform: translateY(-2px);
  }
  @media (max-width: 820px) {
    .intro,
    .about-inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 600px) {
    .ctas .btn {
      flex: 1 1 auto;
    }
  }
</style>
