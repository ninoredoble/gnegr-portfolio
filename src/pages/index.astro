---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import KirigamiHero from '../components/KirigamiHero.astro';
import WorkList from '../components/WorkList.astro';
import SiteFooter from '../components/SiteFooter.astro';
import WeaveBand from '../components/WeaveBand.astro';
import { NAV } from '../data/nav';

const all = await getCollection('work');
const featured = all
  .filter((w) => w.data.featured)
  .sort((a, b) => (a.data.featured ?? 0) - (b.data.featured ?? 0));
---

<Base>
  <KirigamiHero name="NIÑO REDOBLE" nav={NAV} />

  <WeaveBand class="band" />

  <div class="page">
    <section class="wrap intro" id="about">
      <h2 class="display reveal">I DESIGN, BUILD AND RUN SOFTWARE. <em>LATELY WITH A CREW OF AI AGENTS.</em></h2>
      <div class="reveal" style="--d:.1s">
        <p>
          AI product engineer and co-founder of MixCortex, where I'm building Kivora. I take a product from the first
          sketch to the server it runs on, and I direct AI agents to do more of that work than one person could alone.
        </p>
        <div class="ctas">
          <a class="btn solid" href="#work">See the work</a>
          <a class="btn line" href="#contact">Get in touch</a>
        </div>
      </div>
    </section>

    <WorkList items={featured} total={all.length} />

    <SiteFooter />
  </div>
</Base>

<style>
  .band {
    position: relative;
    z-index: 2;
  }
  .page {
    position: relative;
    z-index: 2;
    background: var(--paper);
  }
  .intro {
    padding-block: clamp(64px, 10vw, 140px) clamp(48px, 7vw, 96px);
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: end;
  }
  .intro h2 {
    font-size: clamp(48px, 7.6vw, 118px);
    line-height: 0.88;
  }
  .intro em {
    font-style: normal;
    color: var(--sakura);
  }
  .intro p {
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.55;
    margin-bottom: 24px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .btn.solid {
    background: var(--rosewood);
    border-color: var(--rosewood);
    color: var(--paper);
  }
  .btn.solid:hover {
    background: var(--sakura);
    border-color: var(--sakura);
  }
  .btn.line {
    color: var(--rosewood);
  }
  .btn.line:hover {
    color: var(--sakura);
  }
  .page :global(.site-footer) {
    margin-bottom: 0;
  }
  @media (max-width: 820px) {
    .intro {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 600px) {
    .ctas .btn {
      flex: 1 1 auto;
    }
  }
</style>
